          ]
        },
        "wingtip_l": {
          "rotation": [
            0,
            0,
            "q.property('sky:flying') ? math.sin(q.life_time * 300 - 70) * 24 : -18"
          ]
        },
        "wing_r": {
          "rotation": [
            0,
            0,
            "q.property('sky:flying') ? -math.sin(q.life_time * 300) * 30 : -(10 + math.sin(q.life_time * 90) * 3)"
          ]
        },
        "wingtip_r": {
          "rotation": [
            0,
            0,
            "q.property('sky:flying') ? -math.sin(q.life_time * 300 - 70) * 24 : 18"
          ]
        },
        "body": {
          "position": [
            0,
            "q.property('sky:flying') ? math.sin(q.life_time * 300 - 90) * 1.2 : 0",
            0
          ]
        },
        "jaw": {
          "rotation": [
            "q.property('sky:flying') ? 6 + math.sin(q.life_time * 150) * 4 : 0",
            0,
            0
          ]
        }
      }
    },
    "animation.sky.peter_walk": {
      "loop": true,
      "bones": {
        "leg_fl": {
          "rotation": [
            "q.property('sky:flying') ? 35 : math.cos(q.modified_distance_moved * 25) * 30 * q.modified_move_speed",
            0,
            0
          ]
        },
        "leg_br": {
          "rotation": [
            "q.property('sky:flying') ? 35 : math.cos(q.modified_distance_moved * 25) * 30 * q.modified_move_speed",
            0,
            0
          ]
        },
        "leg_fr": {
          "rotation": [
            "q.property('sky:flying') ? 35 : -math.cos(q.modified_distance_moved * 25) * 30 * q.modified_move_speed",
            0,
            0
          ]
        },
        "leg_bl": {
          "rotation": [
            "q.property('sky:flying') ? 35 : -math.cos(q.modified_distance_moved * 25) * 30 * q.modified_move_speed",
            0,
            0
          ]
        }
      }
    },
    "animation.sky.peter_tail": {
      "loop": true,
      "bones": {
        "tail1": {
          "rotation": [
            0,
            "math.sin(q.life_time * 80) * 6",
            0
          ]
        },
        "tail2": {
          "rotation": [
            0,
            "math.sin(q.life_time * 80 - 30) * 9",
            0
          ]
        },
        "tail3": {
          "rotation": [
            0,
            "math.sin(q.life_time * 80 - 60) * 12",
            0
          ]
        },
        "tail4": {
          "rotation": [
            0,
            "math.sin(q.life_time * 80 - 90) * 14",
            0
          ]
        },
        "comet": {
          "rotation": [
            0,
            "math.sin(q.life_time * 80 - 120) * 16",
            0
          ]
