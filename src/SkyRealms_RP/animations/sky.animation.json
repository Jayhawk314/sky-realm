    "animation.sky.peter_look": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "q.target_x_rotation * 0.5",
            "q.target_y_rotation * 0.5",
            0
          ]
        }
      }
    },
    "animation.sky.spin": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "q.life_time * 720",
            "q.life_time * 540",
            0
          ]
        }
      }
    }
  }
}
